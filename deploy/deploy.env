# WOROOD HUB — deployment configuration
#
# Every repo-specific and host-specific assumption lives here. If a script
# does the wrong thing, the fix is almost certainly one line in this file
# rather than a change to the script.
#
# This file is committed. It contains NO secrets — secrets live in
# /etc/worood-hub/api.env, which is generated on the instance and never
# enters version control.
#
# Sourced by: ec2-bootstrap.sh, release.sh, rollback.sh, backup.sh, restore.sh

# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------
APP_NAME="worood-hub"
HUB_HOSTNAME="${HUB_HOSTNAME:-hub.worood.co}"
ADMIN_EMAIL="${ADMIN_EMAIL:-technology@worood.co}"

# ---------------------------------------------------------------------------
# Filesystem layout
# ---------------------------------------------------------------------------
# Where the git checkout lives. Source only — never served, never written to
# by the running service.
REPO_DIR="${REPO_DIR:-/opt/worood-hub}"

# Where built releases are published. CURRENT_LINK is an atomically swapped
# symlink into RELEASES_DIR, which is what makes rollback instant.
DEPLOY_ROOT="${DEPLOY_ROOT:-/srv/worood-hub}"
RELEASES_DIR="${DEPLOY_ROOT}/releases"
CURRENT_LINK="${DEPLOY_ROOT}/current"

# Secrets and runtime configuration.
CONFIG_DIR="/etc/worood-hub"
API_ENV_FILE="${CONFIG_DIR}/api.env"

# How many old releases to keep on disk. Each is roughly the size of
# node_modules for the API plus the web bundle — budget ~300 MB each.
KEEP_RELEASES="${KEEP_RELEASES:-5}"

# ---------------------------------------------------------------------------
# Service accounts and units
# ---------------------------------------------------------------------------
SERVICE_USER="worood"
SERVICE_GROUP="worood"
API_SERVICE="worood-hub-api"
WORKER_SERVICE="worood-hub-worker"   # Module 2 only; not enabled by default

# ---------------------------------------------------------------------------
# Runtime versions
# ---------------------------------------------------------------------------
# Node 22 is what the prototype was built and verified on. Node 22 entered
# maintenance in October 2025 and reaches end of life in April 2027; Node 24
# is the current Active LTS. Moving to 24 is a planned upgrade, not a
# launch-day decision — change this line and re-run bootstrap when you do.
NODE_MAJOR="${NODE_MAJOR:-22}"

# PostgreSQL 16 is what the schema and the exclusion constraint were verified
# against. PG 18 is current upstream; there is no reason to be first here.
PG_VERSION="${PG_VERSION:-16}"

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_NAME="${DB_NAME:-worood_hub}"
DB_USER="${DB_USER:-worood_hub}"
DB_HOST="127.0.0.1"
DB_PORT="5432"

# ---------------------------------------------------------------------------
# Application ports and health
# ---------------------------------------------------------------------------
API_PORT="${API_PORT:-3000}"

# NOTE — open item. The Technical Design Document uses /health in the API
# surface table (§5) and /healthz in the operations section (§8.4). Set this
# to whichever the code actually implements; release.sh gates the deploy on
# it, so a wrong value here makes every deploy look like a failure.
HEALTH_PATH="${HEALTH_PATH:-/api/v1/health}"

# How long release.sh waits for the service to come up healthy before it
# decides the deploy failed and rolls back.
HEALTH_TIMEOUT_SECONDS="${HEALTH_TIMEOUT_SECONDS:-60}"

# ---------------------------------------------------------------------------
# Build — VERIFY THESE AGAINST THE REPO
#
# These are the four assumptions most likely to be wrong, because they depend
# on the actual package.json scripts rather than on the design document.
# ---------------------------------------------------------------------------
API_DIR="apps/api"
WEB_DIR="apps/web"

# Command that produces the API build inside API_DIR.
API_BUILD_CMD="${API_BUILD_CMD:-npm run build}"

# Command that produces the web bundle inside WEB_DIR.
WEB_BUILD_CMD="${WEB_BUILD_CMD:-npm run build}"

# Build output directories, relative to API_DIR / WEB_DIR.
API_BUILD_OUT="dist"
WEB_BUILD_OUT="dist"

# The API entrypoint inside the published release, relative to the release's
# api/ directory. NestJS conventionally emits dist/main.js.
API_ENTRYPOINT="main.js"

# The migration runner inside the published release, relative to the
# release's api/ directory. systemd runs this in ExecStartPre, so a failed
# migration prevents the new version from ever serving traffic.
MIGRATE_ENTRYPOINT="db/migrate.js"

# SQL migration files, relative to API_DIR. These must be copied into the
# release because they are data the runner reads at runtime, not code the
# compiler bundles.
MIGRATIONS_SRC="src/db/migrations"

# ---------------------------------------------------------------------------
# Backups
# ---------------------------------------------------------------------------
BACKUP_BUCKET="${BACKUP_BUCKET:-worood-hub-backups}"
BACKUP_PREFIX="${BACKUP_PREFIX:-postgres}"
# Objects are aged out by the bucket's lifecycle policy, not by this script.
# The instance role deliberately has no s3:DeleteObject.

# ---------------------------------------------------------------------------
# Memory ceilings (systemd MemoryMax)
# ---------------------------------------------------------------------------
API_MEMORY_MAX="${API_MEMORY_MAX:-1500M}"
WORKER_MEMORY_MAX="${WORKER_MEMORY_MAX:-768M}"
