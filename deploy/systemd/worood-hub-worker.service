# WOROOD HUB — queue worker (Module 2: sales dashboard)
#
# Installed but NOT enabled, and there is nothing to enable yet: the sales
# module's scheduler runs inside the API process, and no worker.js is built.
#
# Kept for the day the sync work is heavy enough to want its own process --
# which is a real possibility at Worood's volume, since a full ShopifyQL
# capture is minutes of work that currently shares a process with the request
# path. Splitting it then means enabling this unit and setting
# SHOPIFY_SCHEDULE_ENABLED=false on the API, not writing anything new.
#
# Deliberately a separate unit rather than a thread inside the API: it can be
# restarted, stopped during an incident, or moved to its own instance later
# without touching the request path.

[Unit]
Description=WOROOD HUB queue worker (BullMQ consumer and schedulers)
Documentation=https://github.com/worood/worood-hub
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
Requires=postgresql.service redis-server.service

# In [Unit], not [Service] — systemd ignores them in [Service].
StartLimitBurst=5
StartLimitIntervalSec=120

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@

WorkingDirectory=@CURRENT_LINK@/api
EnvironmentFile=@API_ENV_FILE@

# No ExecStartPre migration step. Migrations run exactly once per deploy, in
# the API unit. Two units racing to migrate the same database is a subtle and
# unpleasant class of bug.
ExecStart=/usr/bin/node @CURRENT_LINK@/api/worker.js

TimeoutStartSec=60
TimeoutStopSec=60

Restart=on-failure
RestartSec=10s

MemoryMax=@WORKER_MEMORY_MAX@
Environment=NODE_OPTIONS=--max-old-space-size=512
LimitNOFILE=65535

# --- Hardening (identical to the API unit) -----------------------------------
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

StandardOutput=journal
StandardError=journal
SyslogIdentifier=worood-hub-worker

[Install]
WantedBy=multi-user.target
