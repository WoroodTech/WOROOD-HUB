[Unit]
Description=WOROOD HUB API
Documentation=https://hub.worood.co/api/docs
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=worood
Group=worood
WorkingDirectory=/opt/worood-hub/api
EnvironmentFile=/opt/worood-hub/.env

# Migrations run before the process starts, so a deploy that cannot migrate
# never begins serving traffic.
ExecStartPre=/usr/bin/node dist/db/migrate.js
ExecStart=/usr/bin/node dist/main.js

Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=worood-hub-api

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/worood-hub
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=1500M

[Install]
WantedBy=multi-user.target
