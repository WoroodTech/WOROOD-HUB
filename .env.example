NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://worood:CHANGE_ME@127.0.0.1:5432/worood_hub
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=CHANGE_ME
PORTAL_ORIGIN=https://hub.worood.co

# 'fixture' replays captured store data and makes no network calls.
# 'client_credentials' or 'offline' talk to Shopify.
SHOPIFY_TOKEN_STRATEGY=fixture
SHOPIFY_SHOP_DOMAIN=worood-designs.myshopify.com
SHOPIFY_API_VERSION=2026-07
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_PREVIOUS_CLIENT_SECRET=
SHOPIFY_COST_RESTORE_RATE=200

RECONCILE_MINUTES=15
RAW_PAYLOAD_RETENTION_DAYS=30
PII_RETENTION_DAYS=540
STALE_AFTER_MINUTES=180
